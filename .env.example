# To use a real LLM, first rename this file from .env.example to .env
# Then, fill in the details below with the information from your LLM provider
# (like Groq, OpenRouter.ai, etc.)

# The full API endpoint URL
LLM_ENDPOINT="https://api.example.com/v1/chat/completions"

# Your secret API key
LLM_API_KEY="your_api_key_here"

# The specific model you want to use (e.g., "llama3-8b-8192")
LLM_MODEL="your_model_name_here"
